<script>
if (!customElements.get('anox-scale-purchase-v5')) {
  customElements.define(
    'anox-scale-purchase-v5',
    class extends HTMLElement {
      connectedCallback() {
        this.initFrame = requestAnimationFrame(() => this.init());
      }

      disconnectedCallback() {
        cancelAnimationFrame(this.initFrame);
      }

      init() {
        if (this.ready) return;

        this.form = this.querySelector('[data-buy-form]');
        this.select = this.querySelector('[data-variant]');
        this.button = this.querySelector('[data-submit]');
        this.label = this.querySelector('[data-submit-label]');
        this.ctaPrices = this.querySelector('[data-cta-prices]');
        this.status = this.querySelector('[data-status]');
        this.cartLink = this.querySelector('[data-cart-link]');
        this.mainImage = this.querySelector('[data-main-image]');
        this.offer = this.querySelector('[data-bundle-offer]');
        this.toggle = this.querySelector('[data-bundle-toggle]');

        if (!this.form || !this.select || !this.button) return;
        this.ready = true;

        this.state = 'idle';
        this.busy = false;
        this.offerUnavailable = false;

        this.formatter = new Intl.NumberFormat('he-IL', {
          style: 'currency',
          currency: this.dataset.currency || 'ILS',
          minimumFractionDigits: 0,
          maximumFractionDigits: 2
        });

        this.querySelectorAll('button[data-image]').forEach(button => {
          button.addEventListener('click', () => {
            this.showImage(
              button.dataset.image,
              button.dataset.alt
            );
          });
        });

        this.select.addEventListener('change', () => this.sync());

        if (this.toggle) {
          this.offer.hidden = false;
          this.toggle.addEventListener('change', () => this.sync(false));
        }

        this.form.addEventListener('submit', event => {
          event.preventDefault();
          event.stopImmediatePropagation();
          this.addToCart();
        }, true);

        this.sync();
      }

      money(cents) {
        return this.formatter.format(Number(cents) / 100);
      }

      showImage(src, alt) {
        if (!this.mainImage || !src) return;

        this.mainImage.src = src;
        if (alt) this.mainImage.alt = alt;

        this.querySelectorAll('button[data-image]').forEach(button => {
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.image === src)
          );
        });
      }

      sync(changeImage = true) {
        const option = this.select.selectedOptions[0];
        if (!option) return;

        const available = option.dataset.available === 'true';
        const price = Number(option.dataset.cents);
        const old = Number(option.dataset.oldCents);

        if (this.toggle && !available) {
          this.toggle.checked = false;
        }

        const selected = Boolean(
          this.toggle && this.toggle.checked
        );

        this.querySelector('[data-price]').textContent =
          option.dataset.price;

        const compare = this.querySelector('[data-compare]');
        compare.textContent = option.dataset.compare || '';
        compare.hidden = !option.dataset.compare;

        this.querySelector('[data-included-price]').textContent =
          option.dataset.price;

        this.querySelector('[data-included-title]').textContent =
          option.dataset.title;

        this.querySelector('[data-included-status]').textContent =
          available ? '✓ נבחר' : 'אזל מהמלאי';

        const total =
          price + (selected ? Number(this.toggle.dataset.offer) : 0);

        const regular =
          selected ? price + Number(this.toggle.dataset.regular) : old;

        this.querySelector('[data-cta-price]').textContent =
          this.money(total);

        const ctaCompare =
          this.querySelector('[data-cta-compare]');

        ctaCompare.textContent =
          regular > total ? this.money(regular) : '';

        ctaCompare.hidden = regular <= total;

        this.ctaPrices.hidden = !available;
        this.button.disabled = !available;

        this.label.textContent = !available
          ? 'אזל מהמלאי'
          : selected
            ? 'הוספת החבילה לסל'
            : 'הוספה לסל';

        if (this.toggle) {
          this.toggle.disabled =
            !available || this.offerUnavailable;

          const bundleTotal =
            this.querySelector('[data-bundle-total]');

          if (bundleTotal) {
            bundleTotal.textContent = this.money(
              price + Number(this.toggle.dataset.offer)
            );
          }

          const bundleSelection =
            this.querySelector('[data-bundle-selection]');

          if (bundleSelection) {
            bundleSelection.textContent = selected
              ? '✓ הצמיד נבחר — שני המוצרים יתווספו לסל'
              : 'סמנו להוספת הצמיד לחבילה';
          }
        }

        if (changeImage && option.dataset.image) {
          this.showImage(
            option.dataset.image,
            option.dataset.alt
          );
        }
      }

      async request(url, data) {
        const controller = new AbortController();

        const timer = setTimeout(() => {
          controller.abort();
        }, 20000);

        try {
          const response = await fetch(url, {
            method: data ? 'POST' : 'GET',
            credentials: 'same-origin',
            cache: 'no-store',
            signal: controller.signal,
            headers: {
              'Accept': 'application/json',
              ...(data ? {'Content-Type': 'application/json'} : {})
            },
            ...(data ? {body: JSON.stringify(data)} : {})
          });

          let body;

          try {
            body = await response.json();
          } catch (error) {}

          if (!response.ok) {
            const error = new Error(
              typeof body?.description === 'string'
                ? body.description
                : 'לא ניתן להשלים את הבקשה כרגע.'
            );

            error.httpStatus = response.status;
            throw error;
          }

          if (!body) {
            throw new Error('לא התקבל אישור מהחנות.');
          }

          return body;
        } finally {
          clearTimeout(timer);
        }
      }

      cart() {
        return this.request(this.dataset.cartUrl + '.js');
      }

      bundleLines(cart, marker) {
        return (cart.items || []).filter(item => {
          return item.properties?._anox_scale_bundle === marker;
        });
      }

      async removeBundle(marker) {
        const cart = await this.cart();
        const lines = this.bundleLines(cart, marker);

        if (!lines.length) return;

        const updates = {};

        lines.forEach(item => {
          updates[item.key] = Math.max(0, item.quantity - 1);
        });

        await this.request(
          this.dataset.cartUrl + '/update.js',
          {updates}
        );

        const checked = await this.cart();

        if (this.bundleLines(checked, marker).length) {
          throw new Error('יש לבדוק את החבילה בסל.');
        }
      }

      async openCart() {
        if (typeof window.essentialCartApi?.openCart === 'function') {
          try {
            await window.essentialCartApi.openCart();
            return;
          } catch (error) {}
        }

        window.location.assign(this.dataset.cartUrl);
      }

      async addToCart() {
        if (this.busy) return;

        if (this.state !== 'idle') {
          await this.openCart();
          return;
        }

        const option = this.select.selectedOptions[0];

        if (!option || option.dataset.available !== 'true') return;

        const bundle = Boolean(
          this.toggle && this.toggle.checked
        );

        if (
          !bundle &&
          typeof window.essentialCartApi?.openCart !== 'function'
        ) {
          this.busy = true;
          this.button.disabled = true;
          HTMLFormElement.prototype.submit.call(this.form);
          return;
        }

        this.busy = true;
        this.button.disabled = true;
        this.select.disabled = true;

        if (this.toggle) {
          this.toggle.disabled = true;
        }

        this.label.textContent = bundle
          ? 'בודקים ומוסיפים את החבילה…'
          : 'מוסיפים לסל…';

        this.ctaPrices.hidden = true;
        this.status.textContent = '';
        this.cartLink.hidden = true;

        let marker = '';
        let postConfirmed = false;

        try {
          const items = [{
            id: Number(option.value),
            quantity: 1
          }];

          if (bundle) {
            const before = await this.cart();

            if (before.currency !== 'ILS') {
              throw new Error(
                'הטבת החבילה זמינה בתשלום בשקלים.'
              );
            }

            const alreadyInCart = (before.items || []).some(item => {
              return Number(item.variant_id) ===
                Number(this.toggle.dataset.id);
            });

            if (alreadyInCart) {
              throw new Error(
                'הצמיד השחור כבר בסל. אפשר לבטל את סימון החבילה ולהוסיף את המשקל בלבד.'
              );
            }

            marker = 'scale-v4-' + (
              window.crypto?.randomUUID
                ? window.crypto.randomUUID()
                : Date.now() + '-' + Math.random().toString(36).slice(2)
            );

            items[0].properties = {
              _anox_scale_bundle: marker
            };

            items.push({
              id: Number(this.toggle.dataset.id),
              quantity: 1,
              properties: {
                _anox_scale_bundle: marker
              }
            });
          }

          this.state = 'uncertain';

          await this.request(
            this.form.action + '.js',
            {items}
          );

          postConfirmed = true;

          if (bundle) {
            let valid = false;

            try {
              const cart = await this.cart();
              const lines = this.bundleLines(cart, marker);

              const scale = lines.find(item => {
                return Number(item.variant_id) === Number(option.value);
              });

              const band = lines.find(item => {
                return Number(item.variant_id) ===
                  Number(this.toggle.dataset.id);
              });

              valid =
                cart.currency === 'ILS' &&
                lines.length === 2 &&
                scale?.quantity === 1 &&
                band?.quantity === 1 &&
                Number.isFinite(band.final_line_price) &&
                band.final_line_price <= Number(this.toggle.dataset.offer) &&
                Number.isFinite(scale.final_line_price) &&
                scale.final_line_price <= Number(option.dataset.cents);
            } catch (error) {}

            if (!valid) {
              await this.removeBundle(marker);

              this.state = 'idle';
              this.toggle.checked = false;
              this.offerUnavailable = true;
              this.offer.hidden = true;
              this.sync(false);

              throw new Error(
                'הטבת החבילה אינה זמינה כרגע. שני הפריטים שהוספנו הוסרו מהסל; אפשר להוסיף את המשקל בלבד.'
              );
            }
          }

          this.state = 'added';

          this.status.textContent = bundle
            ? 'החבילה נוספה לסל והמחיר המוזל של הצמיד אומת.'
            : 'המוצר נוסף לסל.';

          this.cartLink.hidden = false;

          await this.openCart();
        } catch (error) {
          if (
            !bundle &&
            !postConfirmed &&
            error.httpStatus >= 400 &&
            error.httpStatus < 500
          ) {
            this.state = 'idle';
          }

          this.status.textContent =
            this.state === 'idle'
              ? error.message
              : bundle
                ? 'לא ניתן לאשר את מצב החבילה וההנחה כרגע. בדקו את המחירים בסל לפני המשך לתשלום.'
                : 'לא ניתן לאשר את מצב ההוספה כרגע. בדקו את הסל לפני הוספה נוספת.';

          this.cartLink.hidden = false;
        } finally {
          this.busy = false;

          const idle = this.state === 'idle';

          this.select.disabled = !idle;

          if (this.toggle) {
            this.toggle.disabled =
              !idle || this.offerUnavailable;
          }

          if (idle) {
            this.sync(false);
          } else {
            this.button.disabled = false;
            this.ctaPrices.hidden = true;
            this.label.textContent = 'לצפייה בסל';
          }
        }
      }
    }
  );
}
</script>

<style>
