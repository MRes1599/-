<script>
if (!customElements.get('anox-scale-videos-v1')) {
  customElements.define(
    'anox-scale-videos-v1',
    class extends HTMLElement {
      connectedCallback() {
        this.frame = requestAnimationFrame(() => this.init());
      }

      disconnectedCallback() {
        cancelAnimationFrame(this.frame);
        this.observer?.disconnect();

        if (this.dialog?.open) {
          this.dialog.close();
        }

        this.stop();
        this.events?.abort();
        this.ready = false;
      }

      init() {
        if (this.ready || !this.isConnected) return;

        this.dialog = this.querySelector('dialog');

        this.player = this.querySelector(
          '[data-scale-video-player]'
        );

        this.status = this.querySelector(
          '[data-scale-video-status]'
        );

        this.fallback = this.querySelector(
          '[data-scale-video-fallback]'
        );

        if (!this.dialog || !this.player) return;

        this.ready = true;
        this.events = new AbortController();

        const options = {
          signal: this.events.signal
        };

        this.querySelectorAll(
          '[data-scale-video]'
        ).forEach(card => {
          card.addEventListener('click', event => {
            if (
              event.ctrlKey ||
              event.metaKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }

            if (typeof this.dialog.showModal !== 'function') {
              return;
            }

            event.preventDefault();
            this.open(card);
          }, options);
        });

        this.querySelector(
          '[data-scale-video-close]'
        ).addEventListener('click', () => {
          this.dialog.close();
        }, options);

        this.dialog.addEventListener('click', event => {
          if (event.target !== this.dialog) return;

          const rect = this.dialog.getBoundingClientRect();

          if (
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          ) {
            this.dialog.close();
          }
        }, options);

        this.dialog.addEventListener('close', () => {
          this.stop();

          if (this.opener?.isConnected) {
            this.opener.focus({
              preventScroll: true
            });
          }
        }, options);

        this.player.addEventListener('error', () => {
          if (!this.dialog.open) return;

          this.status.textContent =
            'לא ניתן להפעיל את הסרטון כרגע.';

          this.status.hidden = false;
          this.fallback.hidden = false;
        }, options);

        this.player.addEventListener('playing', () => {
          this.status.hidden = true;
          this.fallback.hidden = true;
        }, options);

        const loadPreviews = () => {
          this.observer?.disconnect();

          this.querySelectorAll(
            '.as-scale-clips__card>video'
          ).forEach(video => {
            video.addEventListener('loadedmetadata', () => {
              if (
                Number.isFinite(video.duration) &&
                video.duration > 0
              ) {
                try {
                  video.currentTime = Math.min(
                    0.3,
                    video.duration / 2
                  );
                } catch (error) {}
              }
            }, {
              once: true,
              signal: this.events.signal
            });

            video.preload = 'metadata';
            video.load();
          });
        };

        if ('IntersectionObserver' in window) {
          this.observer = new IntersectionObserver(entries => {
            if (entries.some(entry => entry.isIntersecting)) {
              loadPreviews();
            }
          }, {
            rootMargin: '250px'
          });

          this.observer.observe(this);
        } else {
          loadPreviews();
        }
      }

      open(card) {
        this.stop();
        this.opener = card;
        this.status.hidden = true;
        this.fallback.hidden = true;
        this.fallback.href = card.href;
        this.player.src = card.href;
        this.player.muted = false;

        this.player.setAttribute(
          'aria-label',
          card.getAttribute('aria-label')
        );

        if (!this.dialog.open) {
          this.dialog.showModal();
        }

        const token = this.token;
        const play = this.player.play();

        if (play) {
          play.catch(() => {
            if (
              this.token !== token ||
              !this.dialog.open ||
              this.player.error
            ) {
              return;
            }

            this.status.textContent =
              'לחצו על כפתור הניגון בסרטון כדי להתחיל.';

            this.status.hidden = false;
          });
        }
      }

      stop() {
        this.token = (this.token || 0) + 1;

        if (!this.player) return;

        this.player.pause();
        this.player.removeAttribute('src');
        this.player.load();
      }
    }
  );
}
</script>

