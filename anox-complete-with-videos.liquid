<script>
(() => {
if (customElements.get('anox-complete-with-videos')) return;
customElements.define('anox-complete-with-videos', class extends HTMLElement {
connectedCallback() {
this.frame = requestAnimationFrame(() => this.init());
}
init() {
if (this.controller || !this.isConnected) return;
this.form = this.querySelector('form');
if (!this.form) return;
this.controller = new AbortController();
const options = { signal: this.controller.signal };
this.format = new Intl.NumberFormat('he-IL', {
style: 'currency',
currency: this.dataset.currency || 'ILS',
minimumFractionDigits: 0,
maximumFractionDigits: 2
});
this.photos = [...this.querySelectorAll('[data-photo]')];
this.photos.forEach(button => {
button.addEventListener(
'click',
() => this.showPhoto(button.dataset),
options
);
});
this.querySelectorAll('[data-variant]').forEach(input => {
input.addEventListener('change', () => this.sync(), options);
});
this.querySelectorAll('[data-strap]').forEach(input => {
input.addEventListener('change', () => this.totals(), options);
});
this.initQty(options);
this.form.addEventListener(
'submit',
event => this.submit(event),
{ ...options, capture: true }
);
this.form.addEventListener('reset', () => {
cancelAnimationFrame(this.resetFrame);
this.resetFrame = requestAnimationFrame(() => this.sync());
}, options);
this.initVideos(options);
this.sync();
const extras = this.querySelector('[data-extras]');
if (extras) extras.hidden = false;
}
initQty(options) {
this.qtyInput = this.querySelector('[data-qty]');
this.qtyPlus = this.querySelector('[data-qty-plus]');
this.qtyMinus = this.querySelector('[data-qty-minus]');
if (!this.qtyInput) return;
this.qtyPlus?.addEventListener('click', () => {
this.setQty(this.qty() + 1);
}, options);
this.qtyMinus?.addEventListener('click', () => {
this.setQty(this.qty() - 1);
}, options);
this.qtyInput.addEventListener('input', () => {
if (this.qtyInput.value !== '') this.totals();
}, options);
this.qtyInput.addEventListener('change', () => {
this.setQty(this.qty());
}, options);
this.qtyInput.addEventListener('blur', () => {
this.setQty(this.qty());
}, options);
}
qtyMax() {
return Number(this.qtyInput?.max) || 10;
}
qty() {
if (!this.qtyInput) return 1;
const value = Math.floor(Number(this.qtyInput.value));
if (!Number.isFinite(value) || value < 1) return 1;
return Math.min(value, this.qtyMax());
}
setQty(value) {
if (!this.qtyInput) return;
const next = Math.min(Math.max(1, Math.floor(value) || 1), this.qtyMax());
this.qtyInput.value = String(next);
this.totals();
}
initVideos(options) {
this.videoDialog = this.querySelector('.axp-video-dialog');
this.videoPlayer = this.querySelector('[data-video-player]');
if (!this.videoDialog || !this.videoPlayer) return;
this.querySelectorAll('[data-video-src]').forEach(button => {
button.addEventListener('click', () => {
this.videoTrigger = button;
this.videoPlayer.pause();
this.videoPlayer.src = button.dataset.videoSrc;
if (button.dataset.videoPoster) {
this.videoPlayer.poster = button.dataset.videoPoster;
} else {
this.videoPlayer.removeAttribute('poster');
}
this.videoDialog.showModal();
const playback = this.videoPlayer.play();
if (playback) playback.catch(() => {});
}, options);
});
this.querySelector('[data-video-close]').addEventListener(
'click',
() => this.videoDialog.close(),
options
);
this.videoDialog.addEventListener('click', event => {
if (event.target === this.videoDialog) {
this.videoDialog.close();
}
}, options);
this.videoDialog.addEventListener('close', () => {
this.stopVideo();
if (this.videoTrigger?.isConnected) {
this.videoTrigger.focus({ preventScroll: true });
}
}, options);
}
stopVideo() {
if (!this.videoPlayer) return;
this.videoPlayer.pause();
this.videoPlayer.removeAttribute('src');
this.videoPlayer.removeAttribute('poster');
this.videoPlayer.load();
}
money(cents) {
return this.format.format(cents / 100);
}
straps() {
return [...this.querySelectorAll('[data-strap]:checked')]
.filter(input => !input.disabled);
}
showPhoto(data) {
const image = this.querySelector('[data-main]');
if (!image || !data.src) return;
image.src = data.src;
image.alt = data.alt || '';
if (data.width && data.height) {
image.width = Number(data.width);
image.height = Number(data.height);
}
this.photos.forEach(button => {
button.setAttribute(
'aria-pressed',
String(button.dataset.src === data.src)
);
});
}
sync() {
this.selected = this.querySelector('[data-variant]:checked');
if (!this.selected) return;
const d = this.selected.dataset;
const price = Number(d.price);
const old = Number(d.old);
this.querySelectorAll('[data-base-price]').forEach(element => {
element.textContent = this.money(price);
});
const previous = this.querySelector('[data-base-old]');
previous.textContent = this.money(old);
previous.hidden = old <= price;
this.querySelector('[data-half]').textContent =
this.money(Math.round(price / 2));
this.querySelector('[data-included-title]').textContent = d.title;
const included = this.querySelector('[data-included-image]');
if (included && d.src) included.src = d.src;
this.querySelector('[data-product-link]').href = d.url;
this.showPhoto(d);
this.totals();
}
variantData(id) {
return this.querySelector('[data-variant][value="' + id + '"]')?.dataset;
}
braceletIds() {
return [
this.selected.value,
...[...this.querySelectorAll('[data-extra-variant]')].map(s => s.value)
];
}
lines() {
const map = new Map();
this.braceletIds().forEach(id => map.set(id, (map.get(id) || 0) + 1));
return [...map].map(([id, quantity]) => ({ id: Number(id), quantity }));
}
renderMore() {
const box = this.querySelector('[data-more]');
if (!box || !this.selected) return;
const need = this.qty() - 1;
const rows = [...box.querySelectorAll('.axp-more-row')];
const variants = [...this.querySelectorAll('[data-variant]')];
for (let i = rows.length; i < need; i++) {
const row = document.createElement('label');
row.className = 'axp-more-row';
row.innerHTML = '<span>צמיד ' + (i + 2) + '</span>';
const select = document.createElement('select');
select.setAttribute('data-extra-variant', '');
select.setAttribute('aria-label', 'דגם וצבע לצמיד ' + (i + 2));
variants.forEach(v => {
const ok = v.dataset.available === 'true';
const option = new Option(v.dataset.title + (ok ? '' : ' – אזל מהמלאי'), v.value);
option.disabled = !ok;
select.add(option);
});
select.value = this.selected.value;
select.addEventListener('change', () => this.totals());
row.append(select);
box.append(row);
}
rows.slice(need).forEach(row => row.remove());
box.hidden = need < 1;
}
totals() {
if (!this.selected) return;
const d = this.selected.dataset;
const extras = this.straps();
const quantity = this.qty();
let price = 0;
let old = 0;
this.renderMore();
this.braceletIds().forEach(id => {
const v = this.variantData(id) || d;
const unit = Number(v.price);
price += unit;
old += Math.max(Number(v.old), unit);
});
extras.forEach(input => {
const amount = Number(input.dataset.price);
price += amount;
old += Math.max(Number(input.dataset.old), amount);
});
this.querySelector('[data-total-price]').textContent =
this.money(price);
const previous = this.querySelector('[data-total-old]');
previous.textContent = this.money(old);
previous.hidden = old <= price;
const available = d.available === 'true';
this.querySelector('[data-cta-prices]').hidden = !available;
this.querySelector('[data-submit]').disabled =
!available || !!this.busy;
this.querySelector('[data-submit-text]').textContent =
this.busy
? 'מוסיף לסל…'
: available
? 'הוספה לסל'
: 'אזל מהמלאי';
if (this.qtyMinus) {
this.qtyMinus.disabled = !!this.busy || quantity <= 1;
}
if (this.qtyPlus) {
this.qtyPlus.disabled = !!this.busy || quantity >= this.qtyMax();
}
const bracelets = quantity === 1
? 'את הצמיד'
: quantity + ' צמידים';
const note = this.querySelector('[data-total-note]');
note.hidden = !extras.length && quantity === 1;
if (!extras.length) {
note.textContent = 'המחיר כולל ' + bracelets;
} else if (extras.length === 1) {
note.textContent =
'המחיר כולל ' + bracelets + ' ורצועה נוספת אחת';
} else {
note.textContent =
'המחיר כולל ' + bracelets + ' ו־' + extras.length + ' רצועות נוספות';
}
}
async submit(event) {
event.preventDefault();
event.stopImmediatePropagation();
if (
this.busy ||
!this.selected ||
this.selected.dataset.available !== 'true'
) return;
const items = [
...this.lines(),
...this.straps().map(input => ({
id: Number(input.value),
quantity: 1
}))
];
const errorBox = this.querySelector('[data-error]');
errorBox.hidden = true;
this.busy = true;
this.form.setAttribute('aria-busy', 'true');
this.totals();
const controls = [...this.form.querySelectorAll('input, select')]
.map(input => [input, input.disabled]);
controls.forEach(([input]) => {
input.disabled = true;
});
try {
const response = await fetch(this.dataset.addUrl, {
method: 'POST',
credentials: 'same-origin',
headers: {
'Content-Type': 'application/json',
'Accept': 'application/json'
},
body: JSON.stringify({ items })
});
const result = await response.json();
if (!response.ok) {
throw new Error(
typeof result.description === 'string'
? result.description
: 'לא ניתן להוסיף את הבחירה לסל. בדקו את הסל לפני ניסיון נוסף.'
);
}
window.location.assign(this.dataset.cartUrl);
} catch (error) {
this.querySelector('[data-error-text]').textContent =
error instanceof TypeError || error instanceof SyntaxError
? 'לא הצלחנו לאשר שהפריטים נוספו. בדקו את סל הקניות לפני ניסיון נוסף.'
: error.message;
errorBox.hidden = false;
controls.forEach(([input, disabled]) => {
input.disabled = disabled;
});
this.busy = false;
this.form.removeAttribute('aria-busy');
this.totals();
}
}
disconnectedCallback() {
cancelAnimationFrame(this.frame);
cancelAnimationFrame(this.resetFrame);
this.controller?.abort();
this.controller = null;
this.stopVideo();
if (this.videoDialog?.open) {
this.videoDialog.close();
}
}
});
})();
</script>

