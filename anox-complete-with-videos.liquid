{% liquid
  assign anox_video_1 = 'https://cdn.shopify.com/videos/c/o/v/f9e18ad46ee6424c89fe824ccf542d73.mp4'
  assign anox_video_2 = 'https://cdn.shopify.com/videos/c/o/v/75a97438a2074c829a965cb7c363ecec.mp4'
  assign anox_video_3 = 'https://cdn.shopify.com/videos/c/o/v/59902ee29d3e42e3ab86e9b603973fb8.mp4'
  assign anox_video_4 = 'https://cdn.shopify.com/videos/c/o/v/297231843adf41ed87d86007d9c6dd77.mp4'
  assign anox_video_5 = 'https://cdn.shopify.com/videos/c/o/v/59902ee29d3e42e3ab86e9b603973fb8.mp4'
  assign anox_video_6 = 'https://cdn.shopify.com/videos/c/o/v/a9bfaeec207b40f1a335e5d36bf9ec85.mp4'
  assign anox_video_7 = ''
  assign anox_video_8 = ''

  assign anox_poster_1 = ''
  assign anox_poster_2 = ''
  assign anox_poster_3 = ''
  assign anox_poster_4 = ''
  assign anox_poster_5 = ''
  assign anox_poster_6 = ''
  assign anox_poster_7 = ''
  assign anox_poster_8 = ''

  assign p = product
  assign anox_model = p.title | split: ' - ' | first | split: ' – ' | first | strip
  assign straps = all_products['רצועה-אחד-נוספת']
  assign uid = 'anox-complete-' | append: section.id | append: block.id
%}

{% if request.page_type == 'product' and p != blank %}
  {% liquid
    assign chosen = p.selected_or_first_available_variant
    assign main_image = chosen.featured_image | default: p.featured_image
    assign half_price = chosen.price | divided_by: 2.0 | round
    assign rating = p.metafields.reviews.rating.value
    assign reviews = p.metafields.reviews.rating_count.value
  %}

  <anox-complete-with-videos
    class="axp"
    dir="rtl"
    data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    data-add-url="{{ routes.cart_add_url }}.js"
    data-cart-url="{{ routes.cart_url }}"
    aria-labelledby="{{ uid }}-title"
  >
    <div class="axp-layout">

      <div class="axp-info">
        {% if rating != blank and reviews > 0 %}
          <p class="axp-rating">
            <span aria-hidden="true">★</span>
            {{ rating.rating }} מתוך {{ rating.scale_max }}
            · {{ reviews }} חוות דעת
          </p>
        {% endif %}

        <h2 id="{{ uid }}-title">{{ p.title | escape }}</h2>

        <div class="axp-prices" aria-live="polite" aria-atomic="true">
          <s
            data-base-old
            {% unless chosen.compare_at_price > chosen.price %}hidden{% endunless %}
            aria-label="מחיר קודם"
          >{{ chosen.compare_at_price | money }}</s>

          <span data-base-price aria-label="מחיר נוכחי">
            {{ chosen.price | money }}
          </span>
        </div>

        <p class="axp-installments">
          או <strong data-half>{{ half_price | money }}</strong>
          ב־2 תשלומים ללא ריבית
        </p>

        {% if p.description != blank %}
          <p class="axp-description">
            {{ p.description | strip_html | truncatewords: 45 }}
          </p>
        {% endif %}
      </div>

      <div class="axp-gallery">
        {% if main_image != blank %}
          <img
            class="axp-main"
            data-main
            src="{{ main_image | image_url: width: 1200 }}"
            alt="{{ main_image.alt | default: p.title | escape }}"
            width="{{ main_image.width }}"
            height="{{ main_image.height }}"
            loading="lazy"
          >
        {% endif %}

        {% if p.images.size > 1 %}
          <div class="axp-thumbs" aria-label="תמונות המוצר">
            {% for photo in p.images %}
              <button
                type="button"
                data-photo
                data-src="{{ photo | image_url: width: 1200 }}"
                data-alt="{{ photo.alt | default: p.title | escape }}"
                data-width="{{ photo.width }}"
                data-height="{{ photo.height }}"
                aria-label="הצגת תמונה {{ forloop.index }}"
                aria-pressed="{% if photo.id == main_image.id %}true{% else %}false{% endif %}"
              >
                <img
                  src="{{ photo | image_url: width: 180 }}"
                  alt=""
                  width="{{ photo.width }}"
                  height="{{ photo.height }}"
                  loading="lazy"
                >
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="axp-purchase">
        <form
          method="post"
          action="{{ routes.cart_add_url }}"
          accept-charset="UTF-8"
        >
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">

          <h3>הצמיד שלכם</h3>

          <div class="axp-included">
            {% if main_image != blank %}
              <img
                data-included-image
                src="{{ main_image | image_url: width: 180 }}"
                alt=""
                width="68"
                height="68"
              >
            {% endif %}

            <div>
              <strong>{{ anox_model | escape }}</strong>
              <span data-included-title>{{ chosen.title | escape }}</span>
              <span data-base-price>{{ chosen.price | money }}</span>
            </div>

            <small>✓ נבחר</small>
          </div>

          <details
            class="axp-change"
            {% if p.has_only_default_variant %}hidden{% endif %}
          >
            <summary>שינוי צבע או דגם הצמיד</summary>

            <fieldset>
              <legend>
                בחרו {{ p.options | join: ' / ' | escape }}
              </legend>

              <div class="axp-variants">
                {% for v in p.variants %}
                  {% assign vi = v.featured_image | default: p.featured_image %}

                  <label class="axp-choice">
                    <input
                      type="radio"
                      name="id"
                      value="{{ v.id }}"
                      data-variant
                      data-price="{{ v.price }}"
                      data-old="{{ v.compare_at_price | default: v.price }}"
                      data-available="{{ v.available }}"
                      data-title="{{ v.title | escape }}"
                      data-url="{{ v.url }}"
                      data-alt="{{ vi.alt | default: p.title | escape }}"
                      {% if vi != blank %}
                        data-src="{{ vi | image_url: width: 1200 }}"
                        data-width="{{ vi.width }}"
                        data-height="{{ vi.height }}"
                      {% endif %}
                      {% if v.id == chosen.id %}checked{% endif %}
                    >

                    <span class="axp-choice-body">
                      {% if vi != blank %}
                        <img
                          src="{{ vi | image_url: width: 180 }}"
                          alt=""
                          width="52"
                          height="52"
                          loading="lazy"
                        >
                      {% endif %}

                      <span>
                        {{ v.title | escape }}
                        {% unless v.available %}
                          <small>אזל מהמלאי</small>
                        {% endunless %}
                      </span>
                    </span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>
          </details>

          {% if straps != blank %}
            <div class="axp-extras" data-extras hidden>
              <h3>בחרו רצועה נוספת:</h3>

              <p class="axp-note">
                תוספת לבחירה. אפשר להוסיף או להסיר בלחיצה.
              </p>

              {% assign types = straps.variants | map: 'option1' | uniq %}

              {% for type in types %}
                <fieldset>
                  <legend>
                    {% case type %}
                      {% when 'ספורטיבי' %}ספורטיבית
                      {% when 'קלאסי' %}קלאסית
                      {% else %}{{ type | escape }}
                    {% endcase %}
                  </legend>

                  <div class="axp-straps">
                    {% for strap in straps.variants %}
                      {% if strap.option1 == type %}
                        {% assign si = strap.featured_image | default: straps.featured_image %}

                        <label class="axp-choice">
                          <input
                            type="checkbox"
                            data-strap
                            value="{{ strap.id }}"
                            data-price="{{ strap.price }}"
                            data-old="{{ strap.compare_at_price | default: strap.price }}"
                            {% unless strap.available %}disabled{% endunless %}
                          >

                          <span class="axp-strap-body">
                            {% if si != blank %}
                              <img
                                src="{{ si | image_url: width: 240 }}"
                                alt=""
                                width="100"
                                height="100"
                                loading="lazy"
                              >
                            {% endif %}

                            <span class="axp-color">
                              {{ strap.option2 | escape }}
                            </span>

                            <span class="axp-strap-price">
                              {% if strap.compare_at_price > strap.price %}
                                <s aria-label="מחיר מקורי">
                                  {{ strap.compare_at_price | money }}
                                </s>
                                <strong aria-label="מחיר מבצע">
                                  {{ strap.price | money }}
                                </strong>
                              {% else %}
                                <span>{{ strap.price | money }}</span>
                              {% endif %}
                            </span>

                            <span class="axp-strap-action">
                              {% if strap.available %}
                                <span class="axp-add-text">הוספת רצועה</span>
                                <span class="axp-selected-text">✓ נבחרה</span>
                              {% else %}
                                אזל מהמלאי
                              {% endif %}
                            </span>
                          </span>
                        </label>
                      {% endif %}
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </div>

          {% elsif request.design_mode %}
            <p class="axp-note">
              מוצר הרצועות אינו זמין בחנות האונליין.
            </p>
          {% endif %}

          <div class="axp-more" data-more hidden><h3>בחרו דגם וצבע לצמידים הנוספים</h3></div>
          <p class="axp-total-note" data-total-note role="status" hidden></p>

          <div class="axp-error" data-error role="alert" hidden>
            <p data-error-text></p>
            <a href="{{ routes.cart_url }}">לבדיקת סל הקניות</a>
          </div>

          <div class="axp-buy-row">
            <div class="axp-qty" role="group" aria-label="כמות צמידים">
              <button
                type="button"
                data-qty-plus
                aria-label="הוספת צמיד"
              >+</button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="10"
                step="1"
                inputmode="numeric"
                data-qty
                aria-label="כמות"
              >

              <button
                type="button"
                data-qty-minus
                aria-label="הפחתת צמיד"
                disabled
              >−</button>
            </div>

            <button
              type="submit"
              class="axp-cta"
              data-submit
              {% unless chosen.available %}disabled{% endunless %}
            >
              <span data-submit-text>
                {% if chosen.available %}
                  הוספה לסל
                {% else %}
                  אזל מהמלאי
                {% endif %}
              </span>

              <span
                class="axp-cta-prices"
                data-cta-prices
                {% unless chosen.available %}hidden{% endunless %}
              >
                <s
                  data-total-old
                  {% unless chosen.compare_at_price > chosen.price %}hidden{% endunless %}
                  aria-label="מחיר קודם"
                >{{ chosen.compare_at_price | money }}</s>

                <span data-total-price>{{ chosen.price | money }}</span>
              </span>
            </button>
          </div>
        </form>

        <div class="axp-faq">
          <details name="{{ uid }}-faq">
            <summary>
              פרטים
              <span aria-hidden="true">+</span>
            </summary>

            <div class="axp-answer">
              {{ p.description }}
              <p>
                <a data-product-link href="{{ chosen.url }}">
                  לעמוד המוצר המלא
                </a>
              </p>
            </div>
          </details>

          <details name="{{ uid }}-faq">
            <summary>
              משלוח, החזרות ואחריות
              <span aria-hidden="true">+</span>
            </summary>

            <div class="axp-answer">
              {% if shop.shipping_policy.body != blank %}
                <h4>משלוחים</h4>
                {{ shop.shipping_policy.body }}
              {% endif %}

              {% if shop.refund_policy.body != blank %}
                <h4>החזרות והחזרים</h4>
                {{ shop.refund_policy.body }}
              {% endif %}

              {% if shop.shipping_policy.body == blank and shop.refund_policy.body == blank %}
                <p>
                  אפשרויות המשלוח והעלות מוצגות במהלך התשלום.
                  למידע על זמני אספקה והחזרות, ניתן לפנות לשירות הלקוחות.
                </p>
              {% endif %}

              <h4>אחריות ושירות</h4>
              <p>
                לבירור תנאי האחריות לדגם ANOX V4 ולקבלת שירות,
                ניתן לפנות אלינו בטלפון
                <a href="tel:+972515508143"><bdi>0515508143</bdi></a>.
              </p>

              {% if shop.terms_of_service != blank %}
                <a href="{{ shop.terms_of_service.url }}">
                  לתנאי החנות המלאים
                </a>
              {% endif %}
            </div>
          </details>

          <details name="{{ uid }}-faq">
            <summary>
              מה ההבדל משעונים חכמים אחרים?
              <span aria-hidden="true">+</span>
            </summary>

            <div class="axp-answer">
              <p>
                <strong>
                  ANOX V4 מתמקד במעקב אחר השגרה שלך,
                  עם הצגת הנתונים באפליקציה בטלפון.
                </strong>
              </p>
              <p>
                <strong>ללא מסך על הצמיד:</strong>
                צפייה בנתונים נעשית דרך האפליקציה.
              </p>
              <p>
                <strong>מעקב לאורך היום:</strong>
                נתוני השינה, הפעילות וההתאוששות עוזרים להכיר את ההרגלים שלך.
              </p>
              <p>
                <strong>מיקוד בשגרה שלך:</strong>
                מתאים למי שמחפש צמיד למעקב,
                כשהטלפון משמש לצפייה במידע.
              </p>
              <p>
                להשוואת תכונות מסוימות, אפשר לעיין במפרט המלא
                של הדגם בסעיף ״פרטים״.
              </p>
            </div>
          </details>
        </div>

        {% liquid
          assign video_urls = anox_video_1 | append: '|' | append: anox_video_2 | append: '|' | append: anox_video_3 | append: '|' | append: anox_video_4 | append: '|' | append: anox_video_5 | append: '|' | append: anox_video_6 | append: '|' | append: anox_video_7 | append: '|' | append: anox_video_8 | split: '|'
          assign video_posters = anox_poster_1 | append: '|' | append: anox_poster_2 | append: '|' | append: anox_poster_3 | append: '|' | append: anox_poster_4 | append: '|' | append: anox_poster_5 | append: '|' | append: anox_poster_6 | append: '|' | append: anox_poster_7 | append: '|' | append: anox_poster_8 | split: '|'
          assign video_count = 0
        %}

        {% capture video_cards %}
          {% for i in (0..7) %}
            {% assign video_url = video_urls[i] | default: '' %}
            {% assign poster_url = video_posters[i] | default: '' %}

            {% if video_url != blank or request.design_mode %}
              {% assign video_count = video_count | plus: 1 %}

              <button
                type="button"
                class="axp-video-card"
                {% if video_url != blank %}
                  data-video-src="{{ video_url | escape }}"
                  data-video-poster="{{ poster_url | escape }}"
                  aria-label="הפעלת סרטון {{ forloop.index }}"
                  aria-haspopup="dialog"
                {% else %}
                  disabled
                  aria-label="מקום לסרטון {{ forloop.index }}"
                {% endif %}
              >
                {% if poster_url != blank %}
                  <img
                    src="{{ poster_url | escape }}"
                    alt=""
                    width="180"
                    height="320"
                    loading="lazy"
                  >
                {% elsif video_url != blank %}
                  <video
                    src="{{ video_url | escape }}"
                    muted
                    playsinline
                    preload="metadata"
                    tabindex="-1"
                    aria-hidden="true"
                  ></video>
                {% else %}
                  <span class="axp-video-placeholder">
                    סרטון {{ forloop.index }}
                  </span>
                {% endif %}

                <span class="axp-video-play" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                    <path d="M5 3L12 8L5 13V3Z" fill="currentColor"/>
                  </svg>
                </span>
              </button>
            {% endif %}
          {% endfor %}
        {% endcapture %}

        {% if video_count > 0 %}
          <div class="axp-videos" aria-label="סרטוני ANOX">
            <h2 style="margin:0 0 16px;font-family:inherit;font-size:30px;font-weight:700;line-height:1.2;text-align:center;color:#222;">
              אנשים אמיתיים אומרים.
            </h2>

            <div class="axp-video-track">
              {{ video_cards }}
            </div>

            <dialog class="axp-video-dialog" aria-label="צפייה בסרטון ANOX">
              <div class="axp-video-bar">
                <button
                  type="button"
                  data-video-close
                  aria-label="סגירת הסרטון"
                >×</button>
              </div>

              <video
                data-video-player
                controls
                playsinline
                preload="none"
                aria-label="סרטון ANOX"
              ></video>
            </dialog>
          </div>
        {% endif %}

      </div>
    </div>
  </anox-complete-with-videos>

{% elsif request.design_mode %}
  <p dir="rtl">
    לא נמצא מוצר בכתובת anox-v4.
    ודאו שהוא מפורסם בחנות האונליין.
  </p>
{% endif %}

<style>
.axp{display:block;padding:40px 16px;background:#fff;color:#182238;font-family:inherit;text-align:right}
.axp,.axp *{box-sizing:border-box}
.axp [hidden]{display:none !important}
.axp-layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,1fr);grid-template-areas:"gallery info" "gallery purchase";grid-template-rows:auto 1fr;gap:24px 40px;max-width:1600px;margin:auto;align-items:start}
.axp-info{grid-area:info;min-width:0}
.axp-gallery{grid-area:gallery;min-width:0}
.axp-purchase{grid-area:purchase;min-width:0}
.axp h2{font-family:inherit;font-size:clamp(28px,3.4vw,44px);font-weight:700;line-height:1.25;color:#111;margin:0 0 18px}
.axp h3{font-family:inherit;font-size:16px;font-weight:700;line-height:1.5;margin:0 0 12px;color:#182238}
.axp-rating{font-size:12px;margin:0 0 12px}
.axp-rating>span{color:#ffad35}
.axp-prices{display:flex;align-items:baseline;flex-wrap:wrap;gap:9px;direction:rtl}
.axp-prices>s{color:#ff202c;font-size:20px;font-weight:400;text-decoration-thickness:1px;white-space:nowrap;unicode-bidi:isolate}
.axp-prices>span{color:#444;font-size:25px;font-weight:400;white-space:nowrap;unicode-bidi:isolate}
.axp-installments{margin:4px 0 0;color:#888;font-size:14px;line-height:1.6}
.axp-installments strong{color:#707070;font-weight:700}
.axp-description{font-size:14px;line-height:1.8;color:#687080;margin:18px 0 0}
.axp-main{display:block;width:100%;height:auto;aspect-ratio:auto;border-radius:15px}
.axp-thumbs{display:flex;gap:8px;margin-top:10px;padding:3px;overflow-x:auto;scrollbar-width:none;overscroll-behavior-x:contain}
.axp-thumbs::-webkit-scrollbar{display:none}
.axp-thumbs button{display:block;flex:0 0 auto;width:auto;height:64px;margin:0;padding:0;background:transparent;border:2px solid transparent;border-radius:9px;overflow:hidden;cursor:pointer}
.axp-thumbs button[aria-pressed="true"]{border-color:#1676ff}
.axp-thumbs img{display:block;width:auto;height:100%;max-width:none;aspect-ratio:auto}
.axp form{margin:0}
.axp-included{display:flex;align-items:center;gap:12px;padding:12px;border:1.5px solid #1676ff;border-radius:13px;background:#f4f8ff}
.axp-included>img{width:68px;height:68px;object-fit:contain;border-radius:8px;background:#f1f0ee}
.axp-included>div{display:flex;flex:1;flex-direction:column;gap:4px;font-size:12px;min-width:0}
.axp-included strong{font-size:15px}
.axp-included>small{font-size:11px;color:#1676ff;white-space:nowrap}
.axp-change{margin:10px 0 20px}
.axp-change>summary{padding:5px 0;font-size:12px;color:#53647b;text-decoration:underline;cursor:pointer}
.axp fieldset{min-width:0;margin:14px 0 18px;padding:0;border:0}
.axp legend{margin:0 0 10px;padding:0;font-size:13px;font-weight:600}
.axp-variants{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.axp-choice{display:block;position:relative;min-width:0;margin:0;cursor:pointer}
.axp-choice>input{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.axp-choice-body{display:flex;align-items:center;gap:9px;height:100%;padding:10px;border:1.5px solid #e0e2e6;border-radius:12px;background:#fff;font-size:12px}
.axp-choice-body>img{width:48px;height:48px;object-fit:contain}
.axp-choice-body small{display:block;font-size:10px;color:#888}
.axp-choice>input:checked + .axp-choice-body{border-color:#1676ff;background:#f2f7ff}
.axp-extras{margin:22px 0;padding-top:18px;border-top:1px solid #e8ebef}
.axp-note{margin:0 0 14px;font-size:11px;line-height:1.6;color:#838894}
.axp-straps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}
.axp-strap-body{display:flex;flex-direction:column;height:100%;padding:7px;border:1.5px solid #e2e5eb;border-radius:11px;background:#fff}
.axp-strap-body>img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain;border-radius:7px;background:#f0efed}
.axp-color{margin:7px 0 4px;font-size:11px;font-weight:600;line-height:1.4}
.axp-strap-price{display:flex;flex-wrap:wrap;align-items:center;gap:3px 6px;margin-bottom:8px;font-size:10px;line-height:1.5}
.axp-strap-price s,.axp-strap-price>span{color:#168047}
.axp-strap-price strong{color:#dc303b;font-weight:600}
