.av2-strap-action{display:flex;align-items:center;justify-content:center;min-height:29px;margin-top:auto;padding:4px 2px;border:1px solid #d8d8d8;border-radius:999px;color:#171717;font-size:10px;line-height:1.4;text-align:center}
.av2-selected-text{display:none}
.av2-choice>input:checked+.av2-strap-body{border-color:#171717;box-shadow:0 0 0 1px #171717;background:#f7f7f7}
