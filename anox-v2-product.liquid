<style>
.av2 .av2-video-dialog{padding:0;overflow:hidden;background:transparent;box-shadow:none;max-height:calc(100dvh - 32px)}
.av2 .av2-video-dialog::backdrop{background:transparent;backdrop-filter:none}
.av2 .av2-video-dialog>video{display:block;width:100%;height:auto;max-height:calc(100dvh - 32px);margin:0;border-radius:16px;background:transparent;object-fit:contain}
.av2 .av2-video-bar{position:absolute;top:10px;left:10px;right:auto;z-index:2;width:36px;height:36px;padding:0;background:transparent;pointer-events:none}
