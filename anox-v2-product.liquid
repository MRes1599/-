.av2-qty>input:focus{outline:none}
.av2-qty:focus-within{border-color:#1676ff}
.av2-more{margin:16px 0 0;padding:12px;border:1px solid #e2e2e2;border-radius:13px;background:#fafafa}
.av2 .av2-more>h3{font-size:14px;margin:0 0 10px}
.av2-more-row{display:flex;align-items:center;gap:10px;margin:0 0 8px;font-size:13px;font-weight:600}
.av2-more-row:last-child{margin:0}
.av2-more-row>span{flex:0 0 auto;min-width:52px}
.av2 .av2-more-row>select{flex:1;min-width:0;min-height:42px;margin:0;padding:8px 10px;border:1px solid #d6dde8;border-radius:10px;background:#fff;color:#171717;font:inherit;font-weight:400}
.av2 .av2-cta{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;flex:1 1 0;gap:6px 9px;width:auto;min-width:0;min-height:49px;margin:0;padding:13px 16px;border:0;border-radius:999px;background:#171717;color:#fff;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer;box-shadow:none}
.av2-cta::before,.av2-cta::after{display:none}
.av2-cta-prices{display:flex;align-items:center;gap:7px;font-size:14px}
.av2-cta-prices s{color:#bdbdbd;font-size:12px}
.av2 .av2-cta:disabled{background:#e1e3e6;color:#797e86;cursor:not-allowed}
.av2-total-note{text-align:center;color:#666666;font-size:12px;margin:0 0 10px}
.av2-error{margin:12px 0;padding:12px;border-radius:9px;background:#fff2f2;color:#a51d27;font-size:13px}
.av2-error p{margin:0 0 6px}
.av2-error a{color:inherit}
.av2-faq{display:grid;gap:7px;margin-top:24px;padding:7px;border-radius:17px;background:#f4f4f4}
.av2-faq>details{min-width:0;border:0;border-radius:12px;background:#fff;overflow:hidden}
.av2-faq summary{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:55px;padding:15px;color:#292929;font-size:14px;line-height:1.5;list-style:none;cursor:pointer}
.av2-faq summary::-webkit-details-marker{display:none}
.av2-faq summary::marker{content:""}
.av2-faq summary::before,.av2-faq summary::after{display:none}
.av2-faq summary>span{font-size:23px;font-weight:400;color:#777;line-height:1}
.av2-faq details[open]>summary>span{transform:rotate(45deg)}
.av2-answer{padding:0 15px 20px;color:#717171;font-size:13px;line-height:1.85;overflow-wrap:anywhere;overflow-x:auto}
.av2-answer p{margin:0 0 12px}
.av2-answer strong,.av2-answer h4{color:#252525}
.av2-answer h4{font-size:14px;margin:15px 0 8px}
.av2-answer a{color:inherit;text-decoration:underline}
.av2-answer img,.av2-answer video,.av2-answer iframe{max-width:100%}
.av2-answer img,.av2-answer video{height:auto}
.av2 button:focus-visible,.av2 summary:focus-visible,.av2 a:focus-visible,.av2-choice>input:focus-visible+span{outline:2px solid #171717;outline-offset:3px}
.av2-videos{width:100%;min-width:0;margin:20px 0 0}
.av2-video-track{display:flex;gap:12px;width:100%;padding:4px 2px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:none}
.av2-video-track::-webkit-scrollbar{display:none}
.av2 .av2-video-card{position:relative;display:block;flex:0 0 calc((100% - 36px)/4);min-width:0;aspect-ratio:9/16;margin:0;padding:0;border:0;border-radius:9px;overflow:hidden;background:#eeefef;color:#fff;cursor:pointer;scroll-snap-align:start;box-shadow:none}
.av2-video-card::before,.av2-video-card::after{display:none}
.av2-video-card>img,.av2-video-card>video{position:absolute;inset:0;display:block;width:100%;height:100%;margin:0;object-fit:cover;pointer-events:none}
.av2-video-play{position:absolute;left:8px;bottom:10px;display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:#171717;color:#fff;pointer-events:none}
.av2-video-play svg{margin-left:1px}
.av2-video-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:7px;background:linear-gradient(145deg,#f0f1f2,#e3e6e8);color:#8e969f;font-size:11px;font-family:inherit}
.av2 .av2-video-card:disabled{cursor:default}
.av2-video-card:disabled .av2-video-play{opacity:.4}
.av2-video-dialog{position:fixed;inset:0;width:min(420px,calc(100vw - 28px));max-width:none;max-height:calc(100dvh - 32px);margin:auto;padding:0;overflow:auto;border:0;border-radius:16px;background:#080808;color:#fff}
.av2-video-dialog:not([open]){display:none}
.av2-video-dialog::backdrop{background:rgba(0,0,0,.76)}
.av2-video-dialog>video{display:block;width:100%;height:auto;max-height:calc(100dvh - 88px);margin:0;background:#080808;object-fit:contain}
.av2-video-bar{display:flex;align-items:center;justify-content:flex-end;height:48px;padding:6px 10px}
.av2-video-bar>button{display:flex;align-items:center;justify-content:center;width:36px;height:36px;margin:0;padding:0;border:0;border-radius:50%;background:#292929;color:#fff;font-family:Arial,sans-serif;font-size:25px;line-height:1;cursor:pointer}
@media(max-width:749px){
.av2{padding:28px 14px}
.av2-layout{grid-template-columns:minmax(0,1fr);grid-template-areas:"info" "gallery" "purchase";grid-template-rows:auto;gap:18px;max-width:540px}
.av2 h2{font-size:28px}
.av2-prices>span{font-size:24px}
.av2-prices>s{font-size:19px}
.av2-thumbs button{height:60px}
.av2-choice-body{flex-direction:column;text-align:center}
.av2-buy-row{gap:8px}
.av2 .av2-qty>button{width:34px}
.av2 .av2-qty>input{width:28px}
.av2 .av2-cta{padding:13px 12px}
.av2-video-track{gap:10px}
.av2 .av2-video-card{flex-basis:calc((100% - 30px)/4);border-radius:8px}
.av2-video-play{left:7px;bottom:9px;width:25px;height:25px}
}
@media(max-width:360px){
.av2-straps{grid-template-columns:repeat(2,minmax(0,1fr))}
}
</style>

<script>
(() => {
if (customElements.get('anox-v2-product-v3')) return;
customElements.define('anox-v2-product-v3', class extends HTMLElement {
connectedCallback() {
this.frame = requestAnimationFrame(() => this.init());
}
init() {
if (this.controller || !this.isConnected) return;
this.form = this.querySelector('form');
if (!this.form) return;
this.controller = new AbortController();
const options = { signal: this.controller.signal };
this.format = new Intl.NumberFormat('he-IL', {
style: 'currency',
currency: this.dataset.currency || 'ILS',
minimumFractionDigits: 0,
maximumFractionDigits: 2
});
this.photos = [...this.querySelectorAll('[data-photo]')];
this.photos.forEach(button => {
button.addEventListener('click', () => this.showPhoto(button.dataset), options);
});
this.querySelectorAll('[data-variant]').forEach(input => {
input.addEventListener('change', () => this.sync(), options);
});
this.querySelectorAll('[data-v2-wear]').forEach(button => {
button.addEventListener('click', () => {
if (this.busy) return;
const candidates = [...this.querySelectorAll('[data-variant]')]
.filter(input => input.dataset.wear === button.dataset.v2Wear);
const next = candidates.find(input => (
input.dataset.color === this.selected?.dataset.color &&
input.dataset.available === 'true'
)) || candidates.find(input => input.dataset.available === 'true') || candidates[0];
if (!next) return;
next.checked = true;
this.sync();
}, options);
});
this.querySelector('[data-v2-clear]')?.addEventListener('click', () => {
if (this.busy) return;
this.querySelectorAll('[data-strap]').forEach(input => {
input.checked = false;
});
this.totals();
}, options);
this.querySelectorAll('[data-strap]').forEach(input => {
input.addEventListener('change', () => this.totals(), options);
});
this.initQty(options);
this.form.addEventListener('submit', event => this.submit(event), { ...options, capture: true });
this.form.addEventListener('reset', () => {
cancelAnimationFrame(this.resetFrame);
this.resetFrame = requestAnimationFrame(() => this.sync());
}, options);
const help = this.querySelector('[data-help-toggle]');
const bubble = this.querySelector('[data-help-bubble]');
if (help && bubble) {
help.addEventListener('click', () => {
const open = help.getAttribute('aria-expanded') !== 'true';
help.setAttribute('aria-expanded', String(open));
bubble.hidden = !open;
}, options);
document.addEventListener('click', event => {
if (!help.contains(event.target) && !bubble.contains(event.target)) {
this.closeHelp();
}
}, options);
document.addEventListener('keydown', event => {
if (event.key === 'Escape' && !bubble.hidden) {
this.closeHelp();
help.focus({ preventScroll: true });
}
}, options);
}
this.initVideos(options);
this.sync();
const extras = this.querySelector('[data-extras]');
if (extras) extras.hidden = false;
}
initQty(options) {
this.qtyInput = this.querySelector('[data-qty]');
this.qtyPlus = this.querySelector('[data-qty-plus]');
this.qtyMinus = this.querySelector('[data-qty-minus]');
if (!this.qtyInput) return;
this.qtyPlus?.addEventListener('click', () => this.setQty(this.qty() + 1), options);
this.qtyMinus?.addEventListener('click', () => this.setQty(this.qty() - 1), options);
this.qtyInput.addEventListener('input', () => {
if (this.qtyInput.value !== '') this.totals();
}, options);
this.qtyInput.addEventListener('change', () => this.setQty(this.qty()), options);
this.qtyInput.addEventListener('blur', () => this.setQty(this.qty()), options);
}
qtyMax() {
return Number(this.qtyInput?.max) || 10;
}
qty() {
if (!this.qtyInput) return 1;
const value = Math.floor(Number(this.qtyInput.value));
if (!Number.isFinite(value) || value < 1) return 1;
return Math.min(value, this.qtyMax());
}
setQty(value) {
if (!this.qtyInput) return;
this.qtyInput.value = String(Math.min(Math.max(1, Math.floor(value) || 1), this.qtyMax()));
this.totals();
}
variantData(id) {
return this.querySelector('[data-variant][value="' + id + '"]')?.dataset;
}
braceletIds() {
return [
this.selected.value,
...[...this.querySelectorAll('[data-extra-variant]')].map(s => s.value)
];
}
lines() {
const map = new Map();
this.braceletIds().forEach(id => map.set(id, (map.get(id) || 0) + 1));
return [...map].map(([id, quantity]) => ({ id: Number(id), quantity }));
}
renderMore() {
const box = this.querySelector('[data-more]');
if (!box || !this.selected) return;
const need = this.qty() - 1;
const rows = [...box.querySelectorAll('.av2-more-row')];
const variants = [...this.querySelectorAll('[data-variant]')];
for (let i = rows.length; i < need; i++) {
const row = document.createElement('label');
row.className = 'av2-more-row';
row.innerHTML = '<span>צמיד ' + (i + 2) + '</span>';
const select = document.createElement('select');
select.setAttribute('data-extra-variant', '');
select.setAttribute('aria-label', 'רצועה וצבע לצמיד ' + (i + 2));
variants.forEach(v => {
const ok = v.dataset.available === 'true';
const option = new Option(
this.wearLabel(v.dataset.wear) + ' / ' + v.dataset.color + (ok ? '' : ' – אזל מהמלאי'),
v.value
);
option.disabled = !ok;
select.add(option);
});
select.value = this.selected.value;
select.addEventListener('change', () => this.totals());
row.append(select);
box.append(row);
}
rows.slice(need).forEach(row => row.remove());
box.hidden = need < 1;
}
initVideos(options) {
this.videoDialog = this.querySelector('.av2-video-dialog');
this.videoPlayer = this.querySelector('[data-video-player]');
if (!this.videoDialog || !this.videoPlayer) return;
this.querySelectorAll('[data-video-src]').forEach(button => {
button.addEventListener('click', () => {
this.videoTrigger = button;
this.videoPlayer.pause();
this.videoPlayer.src = button.dataset.videoSrc;
if (button.dataset.videoPoster) {
this.videoPlayer.poster = button.dataset.videoPoster;
} else {
this.videoPlayer.removeAttribute('poster');
}
this.videoDialog.showModal();
const playback = this.videoPlayer.play();
if (playback) playback.catch(() => {});
}, options);
});
this.querySelector('[data-video-close]').addEventListener('click', () => this.videoDialog.close(), options);
this.videoDialog.addEventListener('click', event => {
if (event.target === this.videoDialog) this.videoDialog.close();
}, options);
this.videoDialog.addEventListener('close', () => {
this.stopVideo();
if (this.videoTrigger?.isConnected) {
this.videoTrigger.focus({ preventScroll: true });
}
}, options);
}
stopVideo() {
if (!this.videoPlayer) return;
this.videoPlayer.pause();
this.videoPlayer.removeAttribute('src');
this.videoPlayer.removeAttribute('poster');
this.videoPlayer.load();
}
wearLabel(wear) {
return wear === 'למפרק' ? 'לשורש כף היד' : wear;
}
updateOrderSummary() {
const clear = this.querySelector('[data-v2-clear]');
if (clear) {
clear.hidden = !this.straps().length;
clear.disabled = !!this.busy;
}
this.querySelectorAll('[data-v2-wear]').forEach(button => {
button.disabled = !!this.busy;
});
}
closeHelp() {
const toggle = this.querySelector('[data-help-toggle]');
const bubble = this.querySelector('[data-help-bubble]');
if (toggle) toggle.setAttribute('aria-expanded', 'false');
if (bubble) bubble.hidden = true;
}
money(cents) {
return this.format.format(cents / 100);
}
straps() {
return [...this.querySelectorAll('[data-strap]:checked')]
.filter(input => input.dataset.available === 'true');
}
showPhoto(data) {
const image = this.querySelector('[data-main]');
if (!image || !data.src) return;
image.src = data.src;
image.alt = data.alt || '';
if (data.width && data.height) {
image.width = Number(data.width);
image.height = Number(data.height);
}
this.photos.forEach(button => {
button.setAttribute('aria-pressed', String(button.dataset.src === data.src));
});
}
sync() {
this.selected = this.querySelector('[data-variant]:checked');
if (!this.selected) return;
const d = this.selected.dataset;
const price = Number(d.price);
const old = Number(d.old);
this.querySelectorAll('[data-base-price]').forEach(element => {
element.textContent = this.money(price);
});
const previous = this.querySelector('[data-base-old]');
previous.textContent = this.money(old);
previous.hidden = old <= price;
this.querySelector('[data-half]').textContent = this.money(Math.round(price / 2));
this.querySelector('[data-included-title]').textContent = this.wearLabel(d.wear) + ' / ' + d.color;
this.querySelectorAll('[data-v2-color-type]').forEach(label => {
label.hidden = label.dataset.v2ColorType !== d.wear;
});
this.querySelectorAll('[data-v2-wear]').forEach(button => {
button.setAttribute('aria-pressed', String(button.dataset.v2Wear === d.wear));
});
const suggestion = this.querySelector('[data-v2-suggestion]');
if (suggestion) {
suggestion.textContent = d.wear === 'לזרוע'
? 'בחרתם רצועת זרוע. רוצים לענוד גם על היד? אפשר להוסיף רצועה לשורש כף היד.'
: 'בחרתם רצועה ליד. רוצים לענוד גם על הזרוע? אפשר להוסיף רצועת זרוע.';
}
const included = this.querySelector('[data-included-image]');
if (included && d.src) included.src = d.src;
this.querySelector('[data-product-link]').href = d.url;
this.showPhoto(d);
this.totals();
}
totals() {
if (!this.selected) return;
const d = this.selected.dataset;
const extras = this.straps();
const quantity = this.qty();
let price = 0;
let old = 0;
this.renderMore();
this.braceletIds().forEach(id => {
const v = this.variantData(id) || d;
const unit = Number(v.price);
price += unit;
old += Math.max(Number(v.old), unit);
});
extras.forEach(input => {
const amount = Number(input.dataset.price);
price += amount;
old += Math.max(Number(input.dataset.old), amount);
});
this.querySelector('[data-total-price]').textContent = this.money(price);
const previous = this.querySelector('[data-total-old]');
previous.textContent = this.money(old);
previous.hidden = old <= price;
const available = d.available === 'true';
this.querySelector('[data-cta-prices]').hidden = !available;
this.querySelector('[data-submit]').disabled = !available || !!this.busy;
this.querySelector('[data-submit-text]').textContent = this.busy
? 'מוסיף לסל…'
: available ? 'הוספה לסל' : 'אזל מהמלאי';
if (this.qtyMinus) this.qtyMinus.disabled = !!this.busy || quantity <= 1;
if (this.qtyPlus) this.qtyPlus.disabled = !!this.busy || quantity >= this.qtyMax();
this.updateOrderSummary();
const note = this.querySelector('[data-total-note]');
note.hidden = false;
const included = d.wear === 'לזרוע' ? 'רצועת זרוע' : 'רצועה לשורש כף היד';
const base = quantity === 1
? 'המחיר כולל את הצמיד עם ' + included
: 'המחיר כולל ' + quantity + ' צמידים, כל אחד עם הרצועה שנבחרה לו';
note.textContent = extras.length === 0
? (quantity === 1 ? base + ' בצבע ' + d.color : base)
: extras.length === 1
? base + ' ורצועה נוספת אחת'
: base + ' ו־' + extras.length + ' רצועות נוספות';
}
disconnectedCallback() {
cancelAnimationFrame(this.frame);
cancelAnimationFrame(this.resetFrame);
this.controller?.abort();
this.controller = null;
this.stopVideo();
if (this.videoDialog?.open) this.videoDialog.close();
}
});
})();
</script>

