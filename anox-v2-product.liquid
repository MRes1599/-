<script>
(() => {
const tag = 'anox-v2-product-v3';
async function waitForEssentialCart() {
const deadline = Date.now() + 8000;
while (Date.now() < deadline) {
if (typeof window.essentialCartApi?.openCart === 'function') {
return window.essentialCartApi;
}
await new Promise(resolve => setTimeout(resolve, 100));
}
throw new Error('העגלה לא נטענה. רעננו את העמוד ונסו שוב.');
}
customElements.whenDefined(tag).then(Component => {
const proto = Component.prototype;
if (proto.anoxEssentialCartEnabled) return;
proto.anoxEssentialCartEnabled = true;
const previousTotals = proto.totals;
proto.totals = function () {
previousTotals.call(this);
if (this.anoxCartNeedsOpening) {
this.querySelector('[data-submit]').disabled = !!this.busy;
this.querySelector('[data-submit-text]').textContent = this.busy ? 'פותח את העגלה…' : 'פתיחת העגלה';
}
};
proto.submit = async function (event) {
event.preventDefault();
event.stopImmediatePropagation();
if (this.busy) return;
if (
!this.anoxCartNeedsOpening &&
(!this.selected || this.selected.dataset.available !== 'true')
) return;
const items = this.anoxCartNeedsOpening ? null : [
...this.lines(),
...this.straps().map(input => ({
id: Number(input.value),
quantity: 1
}))
];
const errorBox = this.querySelector('[data-error]');
const errorText = this.querySelector('[data-error-text]');
errorBox.hidden = true;
errorBox.querySelectorAll('a').forEach(link => link.remove());
let retry = errorBox.querySelector('[data-essential-retry]');
if (!retry) {
retry = document.createElement('button');
retry.type = 'button';
retry.setAttribute('data-essential-retry', '');
retry.textContent = 'פתיחת העגלה';
retry.style.cssText = 'border:0;background:transparent;color:inherit;text-decoration:underline;font:inherit;cursor:pointer;padding:6px 0;';
retry.addEventListener('click', () => {
if (!this.busy) this.form.requestSubmit();
});
errorBox.append(retry);
}
retry.hidden = true;
this.busy = true;
this.form.setAttribute('aria-busy', 'true');
this.totals();
const controls = [...this.form.querySelectorAll('input, select')]
.map(input => [input, input.disabled]);
controls.forEach(([input]) => {
input.disabled = true;
});
let requestStarted = false;
let confirmedFailure = false;
try {
const api = await waitForEssentialCart();
if (!this.anoxCartNeedsOpening) {
requestStarted = true;
const response = await fetch(this.dataset.addUrl, {
method: 'POST',
credentials: 'same-origin',
headers: {
'Content-Type': 'application/json',
'Accept': 'application/json'
},
body: JSON.stringify({ items })
});
if (!response.ok) {
confirmedFailure = true;
const result = await response.json().catch(() => ({}));
throw new Error(
typeof result.description === 'string'
? result.description
: 'לא ניתן להוסיף את הבחירה לסל כרגע.'
);
}
this.anoxCartNeedsOpening = true;
}
await api.openCart();
this.anoxCartNeedsOpening = false;
} catch (error) {
if (requestStarted && !confirmedFailure) {
this.anoxCartNeedsOpening = true;
}
errorText.textContent = this.anoxCartNeedsOpening
? 'יש לבדוק את העגלה לפני הוספה נוספת. לחצו על פתיחת העגלה כדי להמשיך.'
: error.message;
retry.hidden = !this.anoxCartNeedsOpening;
errorBox.hidden = false;
} finally {
controls.forEach(([input, disabled]) => {
input.disabled = disabled;
});
this.busy = false;
this.form.removeAttribute('aria-busy');
this.totals();
}
};
});
})();
</script>

