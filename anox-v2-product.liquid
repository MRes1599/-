{% liquid
assign p = product
assign anox_supported = false
if request.page_type == 'product' and product.handle == 'anox-v2'
assign anox_supported = true
endif
assign anox_model = 'ANOX V2'
assign straps = all_products['רצועות-לכף-היד-והזרוע']
assign available_straps = straps.variants | where: 'available', true
assign strap_type_key = 'option1'
assign strap_color_key = 'option2'
assign uid = 'anox-v2-' | append: section.id | append: block.id
%}

{% if anox_supported and p != blank %}
{% liquid
assign available_variants = p.variants | where: 'available', true
assign chosen = p.selected_or_first_available_variant
unless chosen.available
assign chosen = available_variants | first
endunless
if chosen == blank
assign chosen = p.variants | first
endif
assign main_image = chosen.featured_image | default: p.featured_image
assign half_price = chosen.price | divided_by: 2.0 | round
assign rating = p.metafields.reviews.rating.value
assign reviews = p.metafields.reviews.rating_count.value
%}

<anox-v2-product-v3
  class="av2 av2-v2"
  dir="rtl"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-add-url="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}"
  aria-labelledby="{{ uid }}-title"
>
<div class="av2-layout">
<div class="av2-info">

{% if rating != blank and reviews > 0 %}
<p class="av2-rating" style="display:flex;align-items:center;justify-content:flex-end;gap:8px;direction:ltr;font-size:12px;" aria-label="{{ rating.rating }} מתוך {{ rating.scale_max }}, {{ reviews }} חוות דעת">
<span aria-hidden="true" style="color:#f4a62a;font-size:17px;letter-spacing:1px;">★★★★★</span>
<span style="color:#64748b;direction:rtl;">3,671+ חוות דעת</span>
</p>
{% endif %}

<h2 id="{{ uid }}-title">
ANOX V2<br>
על היד ביום־יום.<br>
על הזרוע באימון.
</h2>

<div class="av2-prices" aria-live="polite" aria-atomic="true">
<s data-base-old
{% unless chosen.compare_at_price > chosen.price %}hidden{% endunless %}
aria-label="מחיר קודם">{{ chosen.compare_at_price | money }}</s>
<span data-base-price aria-label="מחיר נוכחי">{{ chosen.price | money }}</span>
</div>

<p class="av2-installments">
או <strong data-half>{{ half_price | money }}</strong>
ב־2 תשלומים ללא ריבית
</p>
</div>

<div class="av2-gallery">
{% if main_image != blank %}
<img
class="av2-main"
data-main
src="{{ main_image | image_url: width: 1200 }}"
alt="{{ main_image.alt | default: p.title | escape }}"
width="{{ main_image.width }}"
height="{{ main_image.height }}"
loading="lazy"
>
{% endif %}

{% if p.images.size > 1 %}
<div class="av2-thumbs" aria-label="תמונות המוצר">
{% for photo in p.images %}
<button
type="button"
data-photo
data-src="{{ photo | image_url: width: 1200 }}"
data-alt="{{ photo.alt | default: p.title | escape }}"
data-width="{{ photo.width }}"
data-height="{{ photo.height }}"
aria-label="הצגת תמונה {{ forloop.index }}"
aria-pressed="{% if photo.id == main_image.id %}true{% else %}false{% endif %}"
>
<img
src="{{ photo | image_url: width: 180 }}"
alt=""
width="{{ photo.width }}"
height="{{ photo.height }}"
loading="lazy"
>
</button>
{% endfor %}
</div>
{% endif %}
</div>

<div class="av2-purchase">
<form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8">
<input type="hidden" name="form_type" value="product">
<input type="hidden" name="utf8" value="✓">

<div class="v2-step">
<span class="v2-step-number">1</span>
<h3>איזו רצועה תגיע עם הצמיד?</h3>
</div>
<p class="v2-included-note">
כלול במחיר: צמיד V2 + רצועה אחת לבחירתכם.
</p>

{% if available_variants.size == 0 %}
<p class="av2-note">המוצר אזל מהמלאי כרגע.</p>
{% endif %}

<div class="v2-wear" role="group" aria-label="בחירת הרצועה הכלולה במחיר">
{% assign wear_types = available_variants | map: 'option1' | uniq %}
{% for wear in wear_types %}
<button
type="button"
data-v2-wear="{{ wear | escape }}"
aria-pressed="{% if chosen.option1 == wear %}true{% else %}false{% endif %}"
>
<strong>
{% if wear == 'למפרק' %}
לשורש כף היד
{% else %}
{{ wear | escape }}
{% endif %}
</strong>
<span>
{% if wear == 'למפרק' %}
לענידה על היד
{% else %}
לענידה על הזרוע
{% endif %}
</span>
<small>הרצועה שכלולה במחיר</small>
</button>
{% endfor %}
</div>

<fieldset class="v2-colors">
<legend>בחרו צבע לצמיד </legend>
<div class="av2-variants">
{% for v in available_variants %}
{% assign vi = v.featured_image | default: p.featured_image %}
<label
class="av2-choice"
data-v2-color-type="{{ v.option1 | escape }}"
{% if v.option1 != chosen.option1 %}hidden{% endif %}
>
<input
type="radio"
name="id"
value="{{ v.id }}"
data-variant
data-price="{{ v.price }}"
data-old="{{ v.compare_at_price | default: v.price }}"
data-available="{{ v.available }}"
data-title="{{ v.title | escape }}"
data-wear="{{ v.option1 | escape }}"
data-color="{{ v.option2 | escape }}"
data-url="{{ v.url }}"
data-alt="{{ vi.alt | default: p.title | escape }}"
{% if vi != blank %}
data-src="{{ vi | image_url: width: 1200 }}"
data-width="{{ vi.width }}"
data-height="{{ vi.height }}"
{% endif %}
{% if v.id == chosen.id %}checked{% endif %}
>
<span class="av2-choice-body">
{% if vi != blank %}
<img
src="{{ vi | image_url: width: 180 }}"
alt=""
width="52"
height="52"
loading="lazy"
>
{% endif %}
<span>
{{ v.option2 | escape }}
{% unless v.available %}
<small>אזל מהמלאי</small>
{% endunless %}
</span>
</span>
</label>
{% endfor %}
</div>
</fieldset>

<div class="av2-included">
{% if main_image != blank %}
<img
data-included-image
src="{{ main_image | image_url: width: 180 }}"
alt=""
width="68"
height="68"
>
{% endif %}
<div>
<strong>הצמיד והרצועה שבחרתם</strong>
<span data-included-title>{{ chosen.title | escape }}</span>
<span data-base-price>{{ chosen.price | money }}</span>
</div>
<small>כלול במחיר</small>
</div>

{% if available_straps.size > 0 %}
<div class="av2-extras" data-extras hidden>
<div class="v2-step v2-extras-heading">
<span class="v2-step-number">2</span>
<h3>רוצים גם רצועה נוספת?</h3>
<button
type="button"
class="v2-help"
data-help-toggle
aria-label="מידע על הרצועות הנוספות"
aria-expanded="false"
aria-controls="{{ uid }}-strap-help"
>?</button>

<div
class="v2-help-bubble"
id="{{ uid }}-strap-help"
data-help-bubble
hidden
>
<p>
אפשר להישאר עם הרצועה הכלולה בלבד.
כל רצועה נוספת נרכשת בנפרד, במחיר שמופיע לידה.
</p>
<p data-v2-suggestion></p>
</div>
</div>

{% assign types = available_straps | map: strap_type_key | uniq %}
{% for type in types %}
<fieldset>
<legend>
{% case type %}
{% when 'לזרוע' %}
רצועה נוספת לזרוע
{% when 'למפרק' %}
רצועה נוספת לשורש כף היד
{% else %}
{{ type | escape }}
{% endcase %}
</legend>

<div class="av2-straps">
{% for strap in available_straps %}
{% if strap[strap_type_key] == type %}
{% assign si = strap.featured_image | default: straps.featured_image %}
{% assign strap_src = si | image_url: width: 480 %}
<label class="av2-choice">
<input
type="checkbox"
data-strap
value="{{ strap.id }}"
data-title="{{ strap.title | escape }}"
data-wear="{{ strap.option1 | escape }}"
data-color="{{ strap.option2 | escape }}"
data-available="{{ strap.available }}"
data-price="{{ strap.price }}"
data-old="{{ strap.compare_at_price | default: strap.price }}"
{% unless strap.available %}disabled{% endunless %}
>
<span class="av2-strap-body">
{% if strap_src != blank %}
<img
src="{{ strap_src | escape }}"
alt=""
width="100"
height="100"
loading="lazy"
>
{% endif %}

<span class="av2-color">{{ strap[strap_color_key] | escape }}</span>

<span class="av2-strap-price">
<span class="v2-extra-cost">תוספת</span>
{% if strap.compare_at_price > strap.price %}
<s aria-label="מחיר מקורי">{{ strap.compare_at_price | money }}</s>
<strong aria-label="מחיר מבצע">{{ strap.price | money }}</strong>
{% else %}
<span>{{ strap.price | money }}</span>
{% endif %}
</span>

<span class="av2-strap-action">
{% if strap.available %}
<span class="av2-add-text">הוספת רצועה</span>
<span class="av2-selected-text">✓ נבחרה</span>
{% else %}
אזל מהמלאי
{% endif %}
</span>
</span>
</label>
{% endif %}
{% endfor %}
</div>
</fieldset>
{% endfor %}


{% elsif request.design_mode %}
<p class="av2-note">מוצר הרצועות אינו זמין בחנות האונליין.</p>
{% endif %}

<div class="av2-more" data-more hidden><h3>בחרו רצועה וצבע לצמידים הנוספים</h3></div>

<p
class="av2-total-note"
data-total-note
role="status"
aria-live="polite"
>המחיר כולל צמיד V2 ורצועה אחת לבחירתכם.</p>

<div class="av2-error" data-error role="alert" hidden>
<p data-error-text></p>
<a href="{{ routes.cart_url }}">לבדיקת סל הקניות</a>
</div>

<div class="av2-buy-row">
<div class="av2-qty" role="group" aria-label="כמות צמידים">
<button type="button" data-qty-plus aria-label="הוספת צמיד">+</button>
<input type="number" name="quantity" value="1" min="1" max="10" step="1" inputmode="numeric" data-qty aria-label="כמות">
<button type="button" data-qty-minus aria-label="הפחתת צמיד" disabled>−</button>
</div>

<button
type="submit"
class="av2-cta"
data-submit
{% unless chosen.available %}disabled{% endunless %}
>
<span data-submit-text>
{% if chosen.available %}
הוספה לסל
{% else %}
אזל מהמלאי
{% endif %}
</span>

<span
class="av2-cta-prices"
data-cta-prices
{% unless chosen.available %}hidden{% endunless %}
>
<s
data-total-old
{% unless chosen.compare_at_price > chosen.price %}hidden{% endunless %}
aria-label="מחיר קודם"
>{{ chosen.compare_at_price | money }}</s>
<span data-total-price>{{ chosen.price | money }}</span>
</span>
</button>
</div>
</form>

<div class="av2-faq">
<details name="{{ uid }}-faq">
<summary>פרטים <span aria-hidden="true">+</span></summary>
<div class="av2-answer">
<div class="anox-v2-product-details">
  <p>
    <strong>ANOX V2 — צמיד חכם למעקב אחר הבריאות, השינה והפעילות.</strong>
    צמיד ללא מסך, עם צפייה בנתונים דרך האפליקציה בטלפון.
  </p>

  <h4>מעקב אחר השגרה שלכם</h4>
  <ul>
    <li>מעקב אחר השינה.</li>
    <li>מעקב אחר הפעילות לאורך היום.</li>
    <li>צפייה בנתונים באפליקציה בטלפון.</li>
  </ul>

  <h4>על היד או על הזרוע — לבחירתכם</h4>
  <p>
    בעת ההזמנה בוחרים את סוג הרצועה שתגיע עם הצמיד:
    <strong>רצועה לשורש כף היד או רצועה לזרוע.</strong>
    לאחר מכן בוחרים את הצבע מתוך האפשרויות הזמינות במלאי.
  </p>

  <h4>מה כלול בהזמנה?</h4>
  <ul>
    <li>צמיד ANOX V2.</li>
    <li>רצועה אחת, בסוג ובצבע שבחרתם.</li>
  </ul>

  <h4>רוצים להשתמש בשני סוגי הרצועות?</h4>
  <p>
    אפשר להוסיף להזמנה רצועה נוספת לשורש כף היד או לזרוע,
    ולהחליף ביניהן בהתאם לשימוש.
    <strong>הרצועה הראשונה כלולה במחיר הצמיד; כל רצועה נוספת בתשלום.</strong>
  </p>
</div>

<style>
.av2 .anox-v2-product-details{text-align:right;line-height:1.85}
.av2 .anox-v2-product-details h4{margin:20px 0 7px;color:#171717;font-size:14px;font-weight:700}
.av2 .anox-v2-product-details p{margin:0 0 12px}
.av2 .anox-v2-product-details ul{margin:0 0 14px;padding-inline-start:20px;list-style:disc}
.av2 .anox-v2-product-details li{margin-bottom:5px}
</style><p>
<a data-product-link href="{{ chosen.url }}">לעמוד המוצר המלא</a>
</p>
</div>
</details>

<details name="{{ uid }}-faq">
<summary>משלוח, החזרות ואחריות <span aria-hidden="true">+</span></summary>
<div class="av2-answer">
{% if shop.shipping_policy.body != blank %}
<h4>משלוחים</h4>
{{ shop.shipping_policy.body }}
{% endif %}

{% if shop.refund_policy.body != blank %}
<h4>החזרות והחזרים</h4>
{{ shop.refund_policy.body }}
{% endif %}

{% if shop.shipping_policy.body == blank and shop.refund_policy.body == blank %}
<p>
אפשרויות המשלוח והעלות מוצגות במהלך התשלום.
למידע על זמני אספקה והחזרות, ניתן לפנות לשירות הלקוחות.
</p>
{% endif %}

<h4>אחריות ושירות</h4>
<p>
לבירור תנאי האחריות לדגם {{ anox_model | escape }} ולקבלת שירות,
ניתן לפנות אלינו בטלפון
<a href="tel:+972515508143"><bdi>0515508143</bdi></a>.
</p>

{% if shop.terms_of_service != blank %}
<a href="{{ shop.terms_of_service.url }}">לתנאי החנות המלאים</a>
{% endif %}
</div>
</details>

<details name="{{ uid }}-faq">
<summary>מה ההבדל משעונים חכמים אחרים? <span aria-hidden="true">+</span></summary>
<div class="av2-answer">
<p>
<strong>
{{ anox_model | escape }} מתמקד במעקב אחר השגרה שלך,
עם הצגת הנתונים באפליקציה בטלפון.
</strong>
</p>
<p>
{% if anox_model == 'ANOX V7 Time' %}
<strong>תצוגת שעה על הצמיד:</strong>
הצמיד מציג את השעה, והנתונים המפורטים זמינים באפליקציה.
{% else %}
<strong>ללא מסך על הצמיד:</strong>
צפייה בנתונים נעשית דרך האפליקציה.
{% endif %}
</p>
<p>
<strong>מעקב לאורך היום:</strong>
נתוני השינה, הפעילות וההתאוששות עוזרים להכיר את ההרגלים שלך.
</p>
<p>
<strong>מיקוד בשגרה שלך:</strong>
מתאים למי שמחפש צמיד למעקב,
כשהטלפון משמש לצפייה במידע.
</p>
<p>
להשוואת תכונות מסוימות, אפשר לעיין במפרט המלא
של הדגם בסעיף ״פרטים״.
</p>
</div>
</details>
</div>

{% assign anox_v2_videos = 'https://cdn.shopify.com/videos/c/o/v/d330dddae5ef4a63a00843546b3004a3.mp4|https://cdn.shopify.com/videos/c/o/v/55f03ccb0c1940229a8c8a390346b190.mp4|https://cdn.shopify.com/videos/c/o/v/8df6f931d8dd4fd7bab43ec396e92a10.mp4|https://cdn.shopify.com/videos/c/o/v/a2428ed2b0c2448585d2f6883854896a.mp4' | split: '|' %}

<div class="av2-videos" aria-label="אנשים אמיתיים אומרים">
<h2>אנשים אמיתיים אומרים.</h2>

<div class="av2-video-track">
{% for video_url in anox_v2_videos %}
<button
type="button"
class="av2-video-card"
data-video-src="{{ video_url | escape }}"
aria-label="הפעלת סרטון {{ forloop.index }}"
aria-haspopup="dialog"
>
<video
src="{{ video_url | escape }}#t=0.1"
muted
playsinline
preload="metadata"
aria-hidden="true"
tabindex="-1"
></video>
<span class="av2-video-play" aria-hidden="true">
<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
<path d="M8 4v16l13-8z" />
</svg>
</span>
</button>
{% endfor %}
</div>

<dialog class="av2-video-dialog" aria-label="צפייה בסרטון ANOX">
<div class="av2-video-bar">
<button type="button" data-video-close aria-label="סגירת הסרטון">×</button>
</div>
<video
data-video-player
controls
playsinline
preload="none"
aria-label="סרטון ANOX"
></video>
</dialog>
</div>

<style>
.av2.av2-v2 .av2-videos{margin-top:28px}
.av2.av2-v2 .av2-videos>h2{margin:0 0 22px;font-family:inherit;font-size:28px!important;font-weight:800;line-height:1.25;text-align:center;color:#222}
.av2.av2-v2 .av2-video-track{direction:ltr;gap:12px}
.av2.av2-v2 .av2-video-card{flex:0 0 calc((100% - 36px)/4);aspect-ratio:9/16;border-radius:14px}
.av2.av2-v2 .av2-video-play{left:12px;bottom:12px;width:40px;height:40px;background:#1676ff;color:#fff}
@media(max-width:749px){
.av2.av2-v2 .av2-video-card{flex-basis:43%}
.av2.av2-v2 .av2-video-play{left:9px;bottom:9px;width:36px;height:36px}
}
</style>

</div>
</div>
</anox-v2-product-v3>

{% elsif request.design_mode %}
<p dir="rtl">הסקשיין מתאים לדף המוצר ANOX V2. בחרו את V2 בתצוגה המקדימה.</p>
{% endif %}

<style>
.av2{display:block;padding:40px 16px;background:#fff;color:#171717;font-family:inherit;text-align:right}
.av2,.av2 *{box-sizing:border-box}
.av2 [hidden]{display:none!important}
.av2-layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,1fr);grid-template-areas:"gallery info" "gallery purchase";grid-template-rows:auto 1fr;gap:24px 40px;max-width:1180px;margin:auto;align-items:start}
.av2-info{grid-area:info;min-width:0}
.av2-gallery{grid-area:gallery;min-width:0}
.av2-purchase{grid-area:purchase;min-width:0}
.av2 h2{font-family:inherit;font-size:clamp(28px,3.4vw,44px);font-weight:700;line-height:1.25;color:#111;margin:0 0 18px}
.av2 h3{font-family:inherit;font-size:16px;font-weight:700;line-height:1.5;margin:0 0 12px;color:#171717}
.av2-rating{font-size:12px;margin:0 0 12px}
.av2-rating>span{color:#ffad35}
.av2-prices{display:flex;align-items:baseline;flex-wrap:wrap;gap:9px;direction:rtl}
.av2-prices>s{color:#888;font-size:20px;font-weight:400;text-decoration-thickness:1px;white-space:nowrap;unicode-bidi:isolate}
.av2-prices>span{color:#444;font-size:25px;font-weight:400;white-space:nowrap;unicode-bidi:isolate}
.av2-installments{margin:4px 0 0;color:#888;font-size:14px;line-height:1.6}
.av2-installments strong{color:#707070;font-weight:700}
.av2-description{font-size:14px;line-height:1.8;color:#666666;margin:18px 0 0}
.av2-main{display:block;width:100%;height:auto;aspect-ratio:auto;border-radius:15px}
.av2-thumbs{display:flex;gap:8px;margin-top:10px;padding:3px;overflow-x:auto;scrollbar-width:none;overscroll-behavior-x:contain}
.av2-thumbs::-webkit-scrollbar{display:none}
.av2-thumbs button{display:block;flex:0 0 auto;width:auto;height:64px;margin:0;padding:0;background:transparent;border:2px solid transparent;border-radius:9px;overflow:hidden;cursor:pointer}
.av2-thumbs button[aria-pressed="true"]{border-color:#171717}
.av2-thumbs img{display:block;width:auto;height:100%;max-width:none;aspect-ratio:auto}
.av2 form{margin:0}
