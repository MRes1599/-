.av2-v2 .v2-step h3{margin:0;font-size:17px}
.av2-v2 .v2-step-number{display:grid;place-items:center;flex:0 0 25px;height:25px;background:#eeeeee;border-radius:50%;color:#606060;font-size:12px;font-weight:700}
.av2-v2 .v2-included-note{font-size:12px;margin:0 0 13px;color:#666666}
.av2-v2 .v2-wear{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.av2-v2 .v2-wear button{position:relative;padding:15px 7px;border:1px solid #e2e2e2;border-radius:12px;background:white;color:#171717;font-family:inherit;cursor:pointer}
