<style>
.axp .axp-video-dialog{padding:0;overflow:hidden;background:transparent;box-shadow:none;max-height:calc(100dvh - 32px)}
.axp .axp-video-dialog::backdrop{background:transparent;backdrop-filter:none}
.axp .axp-video-dialog>video{display:block;width:100%;height:auto;max-height:calc(100dvh - 32px);margin:0;border-radius:16px;background:transparent;object-fit:contain}
.axp .axp-video-bar{position:absolute;top:10px;left:10px;right:auto;z-index:2;width:36px;height:36px;padding:0;background:transparent;pointer-events:none}
.axp .axp-video-bar>button{width:36px;height:36px;margin:0;background:#fff;color:#222;box-shadow:0 2px 8px rgba(0,0,0,.15);pointer-events:auto}
.axp .axp-rating.axp-reviews-custom{display:flex;align-items:center;justify-content:flex-start;gap:8px;width:fit-content;margin:0 0 12px;padding:0;direction:ltr;line-height:1}
.axp .axp-reviews-custom .axp-reviews-stars{position:relative;display:inline-block;flex-shrink:0;color:#dedede;font-family:Arial,sans-serif;font-size:15px;line-height:1;letter-spacing:1px;white-space:nowrap;direction:ltr}
.axp-reviews-stars>span:first-child{display:block}
.axp-reviews-stars>span:last-child{position:absolute;top:0;left:0;width:96%;overflow:hidden;color:#ffad35;white-space:nowrap}
.axp .axp-reviews-custom .axp-reviews-copy{color:#173353;font-family:inherit;font-size:11px;font-weight:400;line-height:1.4;white-space:nowrap;direction:rtl}
.axp-reviews-copy bdi{font-weight:400}
.axp .axp-strap-body>img{transform:scale(2.2);transform-origin:center;clip-path:inset(18.2857% round 5px)}
.axp .axp-strap-body{background:transparent}
.axp .axp-strap-body>img{background:transparent;mix-blend-mode:multiply;transform:scale(2.1);transform-origin:center;clip-path:inset(27.2727% round 5px)}
.axp .axp-included>img,.axp .axp-choice-body>img{display:block;padding:0;object-fit:cover;object-position:center;border-radius:10px;background:transparent}
.axp .axp-videos>h2{font-size:28px!important}
</style>

